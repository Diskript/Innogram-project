// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Providers {
  LOCAL
  GOOGLE
  FACEBOOK
  GITHUB
  TWITTER
}

enum Visibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum ParticipantRole {
  ADMIN
  MEMBER
}

model User {
  id        String   @id() @default(uuid())
  role      String   @default("USER")
  disabled  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy    String? @map("created_by")
  updatedBy    String? @map("updated_by")
  creator      User?   @relation("UserCreation", fields: [createdBy], references: [id])
  updater      User?   @relation("UserUpdate", fields: [updatedBy], references: [id])
  createdUsers User[]  @relation("UserCreation")
  updatedUsers User[]  @relation("UserUpdate")

  accounts           Account[]      @relation("UserAccounts")
  createdPosts       Post[]         @relation("PostCreation")
  updatedPosts       Post[]         @relation("PostUpdate")
  createdComments    Comment[]      @relation("CommentCreation")
  updatedComments    Comment[]      @relation("CommentUpdate")
  createdAssets      Asset[]        @relation("AssetCreation")
  updatedAssets      Asset[]        @relation("AssetUpdate")
  postsAssets        Posts_Assets[]
  createdPostsAssets Posts_Assets[] @relation("Posts_AssetsCreation")
  updatedPostsAssets Posts_Assets[] @relation("Posts_AssetsUpdate")

  // Profile fields
  userName    String   @unique()
  displayName String   @db.VarChar(50)
  birthday    DateTime
  bio         String   @db.VarChar(500)
  avatarUrl   String   @db.VarChar(500)
  isPublic    Boolean  @default(true)
  deleted     Boolean  @default(false)

  // Relations from Profile model
  comments    Comment[]
  followers   Users_Follows[] @relation("Follower")
  following   Users_Follows[] @relation("Following")
  ownedAssets Asset[]         @relation("AssetOwner")

  // Conversation relations
  conversationParticipants Conversation_Participant[]
  sentMessages             Message[]                  @relation("MessageSender")

  @@index([createdBy])
  @@index([updatedBy])
  @@index([role, disabled])
  @@index([isPublic, deleted])
  @@index([deleted])
  @@index([createdAt])
  @@map("users")
}

model Account {
  id            String    @id() @default(uuid())
  userId        String
  email         String
  passwordHash  String    @db.VarChar(255)
  provider      Providers
  providerId    String
  last_login_at DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation("UserAccounts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([email])
  @@index([provider, providerId])
  @@index([userId])
  @@map("accounts")
}

model Post {
  id        String   @id @default(uuid())
  userId    String
  content   String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy String? @map("created_by")
  creator   User?   @relation("PostCreation", fields: [createdBy], references: [id])
  updatedBy String? @map("updated_by")
  updater   User?   @relation("PostUpdate", fields: [updatedBy], references: [id])

  tags        String[]
  comments    Comment[]      @relation("post_id")
  postsAssets Posts_Assets[]

  @@index([createdAt(sort: Desc)])
  @@index([userId, archived, createdAt])
  @@index([userId, createdAt])
  @@index([archived, createdAt])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([tags], type: Gin)
  @@map("posts")
}

model Comment {
  id              String    @id @default(uuid())
  postId          String
  post            Post      @relation("post_id", fields: [postId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentCommentId String?
  parentComment   Comment?  @relation("CommentParentChild", fields: [parentCommentId], references: [id], onDelete: Cascade)
  childComments   Comment[] @relation("CommentParentChild")
  content         String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?   @map("created_by")
  creator         User?     @relation("CommentCreation", fields: [createdBy], references: [id])
  updatedBy       String?   @map("updated_by")
  updater         User?     @relation("CommentUpdate", fields: [updatedBy], references: [id])

  @@index([postId, createdAt])
  @@index([userId, createdAt])
  @@index([parentCommentId])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("comments")
}

model Asset {
  id            String  @id @default(uuid())
  fileName      String  @db.VarChar(255)
  originalName  String  @db.VarChar(255)
  filePath      String  @db.VarChar(500)
  thumbnailPath String? @db.VarChar(500)
  mediumPath    String? @db.VarChar(500)
  fileType      String  @db.VarChar(50)
  fileSize      Int
  orderIndex    Int     @default(0)

  width    Int?
  height   Int?
  duration Float?

  title       String?
  description String?
  tags        String[]

  visibility Visibility @default(PRIVATE)
  ownerId    String
  owner      User       @relation("AssetOwner", fields: [ownerId], references: [id])

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdBy     String?          @map("created_by")
  creator       User?            @relation("AssetCreation", fields: [createdBy], references: [id])
  updatedBy     String?          @map("updated_by")
  updater       User?            @relation("AssetUpdate", fields: [updatedBy], references: [id])
  postsAssets   Posts_Assets[]
  messageAssets Message_Assets[]

  @@index([ownerId, createdAt])
  @@index([visibility, createdAt])
  @@index([fileType])
  @@index([ownerId, visibility])
  @@index([createdAt])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([ownerId, fileType])
  @@map("assets")
}

model Posts_Assets {
  id         String   @id @default(uuid())
  postId     String
  assetId    String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?  @map("created_by")
  creator    User?    @relation("Posts_AssetsCreation", fields: [createdBy], references: [id])
  updatedBy  String?  @map("updated_by")
  updater    User?    @relation("Posts_AssetsUpdate", fields: [updatedBy], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?

  @@unique([postId, assetId])
  @@index([assetId])
  @@index([userId])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("posts_assets")
}

model Conversation {
  id        String   @id @default(uuid())
  name      String?
  isGroup   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants Conversation_Participant[]
  messages     Message[]

  @@index([createdAt])
  @@index([updatedAt])
  @@map("conversations")
}

model Conversation_Participant {
  id             String          @id @default(uuid())
  conversationId String
  userId         String
  role           ParticipantRole @default(MEMBER)
  joinedAt       DateTime        @default(now())
  leftAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@index([userId, leftAt])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  assets       Message_Assets[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model Message_Assets {
  id        String   @id @default(uuid())
  messageId String
  assetId   String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([assetId])
  @@map("message_assets")
}

model Users_Follows {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([followerId, followingId])
  @@index([followerId, createdAt])
  @@index([followingId, createdAt])
  @@index([followerId])
  @@index([followingId])
  @@map("users_follows")
}
